@model List<Product>
@{
    ViewData["Title"] = "Админ панель";
    var reviews = (List<Review>)ViewBag.Reviews;
}

<h1>Админ панель</h1>

<a href="/Admin/Create" class="btn-buy">Добавить товар</a>

<h2>Товары</h2>
<table class="table">
    <tr>
        <th>Id</th>
        <th></th>
        <th>Название</th>
        <th>Категория</th>
        <th>Цена</th>
        <th></th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td><img src="@p.ImageUrl" class="table-img" alt="" onerror="this.onerror=null;this.src='https://placehold.co/80x60/2a2f38/888888?text=No';" /></td>
            <td><a href="/Home/Details/@p.Id">@p.Name</a></td>
            <td>@p.Category?.Name</td>
            <td>@p.Price.ToString("N0") ₽</td>
            <td>
                <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить товар?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="btn-delete">Удалить</button>
                </form>
            </td>
        </tr>
    }
</table>

<h2>Отзывы</h2>
@if (reviews.Count == 0)
{
    <p class="empty">Отзывов нет</p>
}
else
{
    <table class="table">
        <tr>
            <th>Автор</th>
            <th>Текст</th>
            <th>Оценка</th>
            <th>Дата</th>
            <th></th>
        </tr>
        @foreach (var r in reviews)
        {
            <tr>
                <td>@r.User?.FirstName @r.User?.LastName</td>
                <td>@r.Text</td>
                <td>@r.Rating</td>
                <td>@r.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td>
                    <form asp-controller="Reviews" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button type="submit" class="btn-delete">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}