@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="breadcrumbs">
    <a href="/">Главная</a> /
    <a href="/?categoryId=@Model.CategoryId">@Model.Category?.Name</a> /
    <span>@Model.Name</span>
</div>

<div class="details">
    <div class="details-img">
        <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.onerror=null;this.src='https://placehold.co/500x400/2a2f38/888888?text=No+image';" />
    </div>
    <div class="details-info">
        <h1>@Model.Name</h1>
        <div class="card-category">Категория: @Model.Category?.Name</div>
        <div class="card-stock">В наличии</div>
        <div class="details-price">@Model.Price.ToString("N0") ₽</div>

        @if (User.Identity!.IsAuthenticated)
        {
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn-buy big">Добавить в корзину</button>
            </form>
        }
        else
        {
            <p class="hint"><a href="/Account/Login">Войдите</a>, чтобы добавить товар в корзину</p>
        }

        <h3>Описание</h3>
        <p>@Model.Description</p>
    </div>
</div>